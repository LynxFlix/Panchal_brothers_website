{
  "version": 2,
  "functions": {
    "backend/server.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/server.js"
    },
    {
      "source": "/admin",
      "destination": "frontend/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ],
  "cleanUrls": true
}
