# ============================================================
#  PANCHAL BROTHERS – Environment Variables
#  Copy this file to .env and fill in your real values
#  NEVER commit .env to Git — add it to .gitignore
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── DATABASE ─────────────────────────────────────────────────
# Local MongoDB
MONGO_URI=mongodb+srv://panchaladmin:<password>@panchalbrothers.f2q9ely.mongodb.net/?appName=PanchalBrothers

# OR MongoDB Atlas (cloud) — replace with your connection string
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/panchal_brothers

# ── EMAIL (NODEMAILER) ───────────────────────────────────────
# Gmail App Password (not your regular Gmail password)
# Go to: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=meeralpanchal@panchalbrothers.org
EMAIL_PASS=xtay ssar hhir mnxu

# Company email that receives enquiries
COMPANY_EMAIL=meeralpanchal@panchalbrothers.org
COMPANY_NAME=Panchal Brothers

# ── ADMIN AUTH ───────────────────────────────────────────────
# JWT secret — use a long random string (32+ characters)
JWT_SECRET=panchal_brothers_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Default admin credentials (change immediately after first login)
ADMIN_EMAIL=admin@panchalbrothers.com
ADMIN_PASSWORD=Admin@PB2025

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
